{
  "name": "lagebild",
  "version": "0.1.0",
  "private": true,
  "description": "Lagebild — Wetter, amtliche Warnungen, Verkehr und News für sicheres Bewegen. Offline-first PWA.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter=@lagebild/api --filter=@lagebild/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start": "node apps/api/dist/index.js",
    "check": "pnpm check:import",
    "check:import": "tsx scripts/check-import.mts",
    "check:offline": "tsx scripts/check-offline.mts",
    "check:via": "tsx scripts/check-via.mts",
    "check:terrain": "tsx scripts/check-terrain.mts",
    "check:pakete": "pnpm check:offline && pnpm check:via && pnpm check:terrain"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
