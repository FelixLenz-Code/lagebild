# Lagebild API — Beispiel-Konfiguration. Kopiere nach .env (wird nicht committet).
PORT=8787
HOST=0.0.0.0
# Sekunden, die Proxy-Antworten im Speicher-Cache frisch bleiben
CACHE_TTL_SECONDS=300
# Pfad zum gebauten PWA-Bundle (im Prod-Betrieb ausgeliefert)
WEB_ROOT=./public
# Optional: TomTom-API-Key für die Verkehrsfluss-Ebene (bleibt serverseitig).
# Ohne Key wird die Ebene automatisch ausgeblendet.
TOMTOM_KEY=
# Optional: eigene DB-REST-Instanz (Standard: öffentliche transport.rest)
# TRANSPORT_BASE=https://v6.db.transport.rest
